# Copy to apps/server/.env (never commit .env).

# Base (API and worker), from your Neon project's Connect dialog.
# Pooled URL (host contains "-pooler"): normal queries.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct URL (same host without "-pooler"): migrations, the worker lock, LISTEN/NOTIFY.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"
LOG_LEVEL=info
NODE_ENV=development

# API only
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:5173

# Seed only
PAPER_START_BALANCE=10000

OANDA_API_TOKEN=your-token
OANDA_ACCOUNT_ID=101-001-XXXXXXX-001
OANDA_ENV=practice

# Tests only: a separate, migrated database, wiped by the DB tests. Use a Neon branch
# (for example "test"), direct URL. Uncomment once it exists.
# DATABASE_URL_TEST="postgresql://USER:PASSWORD@ep-yyyy.REGION.aws.neon.tech/neondb?sslmode=require"
